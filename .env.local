# ═══════════════════════════════════════
#  .env.local — المتغيرات السرية (Secret Variables)
#
#  ⚠️  لا ترفع هذا الملف على GitHub أبداً
#  هو موجود في .gitignore تلقائياً
#
#  كيف تحصل على هذي القيم؟
#  ١. افتح supabase.com
#  ٢. أنشئ مشروع جديد
#  ٣. روح Settings → API
#  ٤. انسخ الـ URL والـ anon key
# ═══════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
